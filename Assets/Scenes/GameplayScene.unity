  intervaloSonido: 0.5
  clipsPorLinea: []
  lineas:
  - "\xA1Oyeeeeee!\r"
  - "\xBFQu\xE9 rayos haces aqu\xED?\r"
  - "No deber\xEDa verte por aqu\xED tan\u2026 bueno, tan f\xEDsicamente.\r"
  - "\xBFC\xF3mo llegaste aqu\xED?\r"
  - "\xBFNo tienes idea eh?\r\n"
  - "Eso no es bueno, ser\xE1 mejor que salgas de aqu\xED, y pronto.\r"
  - "Ve r\xE1pido a la habitaci\xF3n del oso.\r"
  - "Cuidado con la ventana, no dejes que entren al cuarto.\r"
  - "Busca el cristal y vuelve aqu\xED.\r"
  tiempoEntreLetras: 0.1
  tiempoAutoAvance: 5
  delayInicio: 1
  scriptMovimiento: {fileID: 1956857694855334363}
