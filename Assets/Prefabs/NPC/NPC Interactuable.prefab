--- !u!114 &9155654798097984999
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4994923534950874088}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d8fa6c7303eb7064fa75579a7ddb8ab0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogos:
  - texto: Oh hola
    tipoCuadro: 1
  - texto: '!!!!!'
    tipoCuadro: 1
  - texto: Espera, tu que haces aqui?!
    tipoCuadro: 1
  - texto: A que te refieres chico?
    tipoCuadro: 0
  - texto: ...
    tipoCuadro: 1
  - texto: Ejem, estas bien?
    tipoCuadro: 0
  - texto: Tienes que irte rapido antes que eso te encuentre
    tipoCuadro: 1
  - texto: Eso? a que te refieres, que no debe encontrarme?
    tipoCuadro: 0
  - texto: No ahi tiempo, te explicare luego, entra a esa habitacion y te ayudare
    tipoCuadro: 1
  cuadroJugador: {fileID: 0}
  cuadroNPCGuia: {fileID: 0}
  textoJugador: {fileID: 0}
  textoNPCGuia: {fileID: 0}
  intervaloLetra: 0.04
  fuenteSonido: {fileID: 1569222915612556455}
  sonidoLetra: {fileID: 8300000, guid: cc326325d300c974dbf6c4ab46e8829d, type: 3}
  letrasMinimasPorSonido: 2
  letrasMaximasPorSonido: 3
  usarDialogoRepetido: 1
  dialogoRepetido:
    texto: Que esperas, ve a la puerta rapido
    tipoCuadro: 1
  cantidadParaDialogoRepetido: 3
  contadorInteracciones: 0
--- !u!114 &7443837086346640651
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
